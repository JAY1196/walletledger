MYSQL_HOST_PORT=3307
MYSQL_DATABASE=walletledger

# Replace every placeholder with a strong, unique local password.
MYSQL_ROOT_PASSWORD=replace_with_local_secret
MYSQL_OWNER_USER=walletledger_owner
MYSQL_OWNER_PASSWORD=replace_with_local_secret
MYSQL_APP_USER=walletledger_app
MYSQL_APP_PASSWORD=replace_with_local_secret

REDIS_HOST_PORT=6380
APP_HOST_PORT=8081

# Generate a private Base64-encoded random secret containing at least 32 bytes.
# Replace this placeholder before starting the application.
WALLETLEDGER_SECURITY_JWT_SECRET=replace_with_your_random_base64_secret
WALLETLEDGER_SECURITY_JWT_EXPIRATION_SECONDS=900
# Automated reconciliation scheduling (disabled by default).
WALLETLEDGER_RECONCILIATION_ENABLED=false
WALLETLEDGER_RECONCILIATION_CRON=0 0 * * * *
WALLETLEDGER_RECONCILIATION_LOCK_NAME=walletledger:scheduled-reconciliation
WALLETLEDGER_RECONCILIATION_LOCK_TIMEOUT_SECONDS=0